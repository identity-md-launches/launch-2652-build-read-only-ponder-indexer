            }
          ]
        },
        "events": {
          "Stacked(address,address,uint256,uint256)": {
            "params": {
              "imd": "IMD pulled from the project and deposited.",
              "project": "The caller that funded the cashback.",
              "shares": "sIMD shares minted to the trader.",
              "trader": "The address that received the sIMD shares."
            }
          }
        },
        "kind": "dev",
        "methods": {
          "constructor": {
            "details": "No external calls: the factory also rehearses deployment on an empty chain. The first non-zero credit checks the live vault and approves it before pulling any caller's tokens.",
            "params": {
              "imd": "The IMD token.",
              "sImd": "The staked-IMD vault; its `asset()` must equal `imd`."
            }
          },
          "credit(address,uint256)": {
            "details": "Reverts with `ZeroTrader` for a zero trader, or `InvalidTrader` for this contract, the IMD token or vault. Returns 0 (no transfer, no event, no state change) for a zero amount and a valid trader. Bubbles up the vault's and token's errors unchanged."
          }
        },
        "title": "Stacker",
        "version": 1
      },
      "userdoc": {
        "errors": {
          "AssetMismatch(address,address)": [
            {
              "notice": "The vault's `asset()` is not the IMD address given to the constructor."
            }
          ],
          "InvalidTrader()": [
            {
              "notice": "Shares sent to the Stacker, IMD token or vault itself would be irrecoverable."
            }
          ],
          "ZeroShares()": [
            {
              "notice": "The vault minted no shares for a non-zero deposit (would silently lose the IMD)."
            }
          ],
          "ZeroTrader()": [
            {
              "notice": "`credit` was called with the zero address as trader."
            }
          ]
        },
        "events": {
          "Stacked(address,address,uint256,uint256)": {
            "notice": "Emitted once per successful non-zero credit. This is the record points are built from."
          }
        },
        "kind": "user",
        "methods": {
          "IMD()": {
            "notice": "The IMD token the vault stakes (the vault's `asset()`)."
          },
          "SIMD()": {
            "notice": "The staked-IMD ERC-4626 vault that receives every deposit."
          },
          "credit(address,uint256)": {
            "notice": "Pull `imdAmount` IMD from the caller and stake it for `trader`; the sIMD shares are minted directly to `trader`. Returns the shares minted."
          },
          "projectShares(address)": {
            "notice": "sIMD shares minted through each project."
          },
          "projectStacked(address)": {
            "notice": "IMD stacked by each project, across all traders."
          },
          "totalStacked()": {
            "notice": "IMD stacked through this contract in total."
          }
        },
        "notice": "imd/acc cashback funnel. A project that wants to pay a trader cashback in staked IMD calls `credit(trader, imdAmount)`: the Stacker pulls `imdAmount` IMD from the project (msg.sender), deposits it into the sIMD vault with the trader as the share recipient, and emits `Stacked`. The project funds the cashback from its own existing fees; the Stacker takes no fee, has no owner or admin, and holds no IMD or sIMD between calls. Per-trader figures (cashback received, points, shares from cashback) come from the `Stacked` events, which record project, trader, IMD and shares for every credit. The contract keeps only per-project totals and the grand total on chain, so a credit writes no new storage per trader. Integrators are expected to wrap `credit` in try/catch: it reverts (and moves nothing) when the vault refuses the deposit, when the project's allowance or balance is short, or when the trader is zero, the Stacker itself, the IMD token, or the vault itself.",
        "version": 1
      }
    },
