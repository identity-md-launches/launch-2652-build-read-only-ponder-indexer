# Copy to .env for Docker Compose. For pnpm dev, export variables or use .env.local.
# No RPC is selected by default. Ethereum mainnet HTTP(S) URL, chain ID 1 only.
# Public trials: https://rpc.flashbots.net/fast or https://one.valve.city/rpc/vk_demo/evm/1
# Public endpoints rate-limit; select a provider that serves historical logs and block reads.
PONDER_RPC_URL_1=
# Requests per second at the transport; lower this for public RPCs.
PONDER_RPC_REQUESTS_PER_SECOND=4
# Maximum inclusive block span for Ponder eth_getLogs; reduce for stricter RPCs.
PONDER_ETH_GET_LOGS_BLOCK_RANGE=500
# Poll the mainnet head every 12 seconds.
PONDER_POLLING_INTERVAL=12000

# Deployed defaults. Address and start block overrides require a fresh deployment schema.
# PLEA: emitting address and inclusive start block.
PLEA_ADDRESS=0x1f158929496162b53fb232536468948e25170ab3
PLEA_START_BLOCK=26293890
# CabalGate: emitting address and inclusive start block.
CABAL_GATE_ADDRESS=0x39ac882a1161ea19acb6fbdd7a5835d96cf876eb
CABAL_GATE_START_BLOCK=26293890
# Seasons: emitting address and inclusive start block.
SEASONS_ADDRESS=0xf7c024f7bc96cf152a572f6e184318ff6d380738
SEASONS_START_BLOCK=26293890
# PleaDistributor: emitting address and inclusive start block.
PLEA_DISTRIBUTOR_ADDRESS=0x97face21c7a9f3b64d0f4e0bf21861721fbbfe3e
PLEA_DISTRIBUTOR_START_BLOCK=26293890
# PleaLaunch: emitting address and inclusive start block.
PLEA_LAUNCH_ADDRESS=0x9e75eabf8d1c905a07a0c99bb9ec9430a065358f
PLEA_LAUNCH_START_BLOCK=26293890
# Letterbox: emitting address and inclusive start block.
LETTERBOX_ADDRESS=0x00423ebaed03445fc1452d9a79a51e3c0dfdab5f
LETTERBOX_START_BLOCK=26294106
# Tribunal: emitting address and inclusive start block.
TRIBUNAL_ADDRESS=0x1aa665eb420f28103324daaaf034de13ee6f53d9
TRIBUNAL_START_BLOCK=26294111
# PleaHook: emitting address and inclusive start block.
PLEA_HOOK_ADDRESS=0xf1122bc96adea8768cff2badf02b6d4594f928cc
PLEA_HOOK_START_BLOCK=26294113
# Stacker: emitting address and inclusive start block.
STACKER_ADDRESS=0x06909f672301f28a810f78cfe7a754851269f4f0
STACKER_START_BLOCK=26294113

# Ponder selects PostgreSQL if either is set; PRIVATE takes precedence. Leave empty for PGlite.
DATABASE_PRIVATE_URL=
DATABASE_URL=
# Optional fixed deployment schema; otherwise Railway deployment ID, then the image build ID.
# Reuse only for a restart of unchanged source/config; change for a new deployment.
DATABASE_SCHEMA=
# Railway supplies this automatically. Leave empty outside Railway.
RAILWAY_DEPLOYMENT_ID=
# Stable SQL views schema; use off to disable views. Do not share across unrelated apps.
PONDER_VIEWS_SCHEMA=plea
# HTTP port inside the process/container; Railway may supply its own PORT.
PORT=42069
# Compose host port, bound only to 127.0.0.1.
APP_PORT=42069
# REQUIRED for Compose: choose a long URL-safe database password. No default credential.
POSTGRES_PASSWORD=
# Railway readiness timeout in seconds; set this on its service Variables screen.
RAILWAY_HEALTHCHECK_TIMEOUT_SEC=3600
# Comparator eth_getLogs chunk size, in blocks (independent of the Ponder range).
COMPARE_BLOCK_RANGE=500
# Treat this many logs as a possible provider cap and split the range; use your RPC cap.
COMPARE_RPC_LOG_LIMIT=10000
